{
  "name": "all-you-plan-web",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write --ignore-path .prettierignore . && eslint --fix --ext .vue .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:build": "RUN_BUILD_TESTS=1 vitest run tests/build/prod-bundle.test.js",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests-e2e/a11y.spec.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@apollo/client": "^3.12.9",
    "@fontsource/instrument-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@heroicons/vue": "^2.2.0",
    "@sentry/vue": "^8.42.0",
    "@vuepic/vue-datepicker": "^13.0.0",
    "graphql": "^16.10.0",
    "graphql-ws": "^5.16.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.0",
    "vue-sonner": "^1.3.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "@pinia/testing": "^1.0.3",
    "@sentry/vite-plugin": "^2.22.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "sass": "^1.98.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.vue": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  }
}
