# All You Plan — web env template.
#
# Required in production: VITE_GRAPHQL_URL, VITE_WS_URL, VITE_WREN_URL.
# A production build (vite build) FAILS FAST via src/config/env.js if any are
# missing/empty. In dev these fall back to safe local defaults, so an empty
# env still runs `npm run dev`.

# GraphQL HTTP endpoint. In development the Vite dev server proxies /graphql to
# the local API; in production set the full API URL.
# Dev default: /graphql
VITE_GRAPHQL_URL=https://api.example.com/graphql

# WebSocket endpoint for GraphQL subscriptions.
# Dev default: ws://localhost:4100/graphql (the committed .env uses this).
VITE_WS_URL=wss://api.example.com/graphql

# Base URL of the standalone Wren product (cross-app "Try Wren" upsell).
# Dev default: http://localhost:5180
VITE_WREN_URL=https://wren.example.com

# Serve fixture data instead of calling the API.
# Dev only — Vite strips import.meta.env.DEV guards at build time, and
# .env.production forces this false, so it has no effect in production builds.
VITE_USE_MOCKS=false

# --- Sentry (Phase 4 Item D / G-13) ---
# Optional. When unset the Sentry init (src/utils/sentry.js) no-ops.
# Init is additionally gated by the cookie-consent analytics bucket
# (src/utils/cookieConsent.js) so a DSN alone is not enough — the user
# must accept analytics in the banner first.
# Source-map upload at build time also needs SENTRY_AUTH_TOKEN (+ org/project)
# set in CI; see vite.config.js.
VITE_SENTRY_DSN=
