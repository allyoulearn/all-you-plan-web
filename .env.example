# GraphQL HTTP endpoint. In development the Vite dev server proxies /graphql to
# the local API. In production set this to the full API URL.
VITE_GRAPHQL_URL=/graphql

# WebSocket endpoint for GraphQL subscriptions.
VITE_WS_URL=ws://localhost:4100/graphql

# Serve fixture data instead of calling the API.
# Dev only — Vite strips import.meta.env.DEV guards at build time so this flag
# has no effect in production builds even if set.
VITE_USE_MOCKS=false
